{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-advance-testing"
		},
		"ls_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls'"
		},
		"ls_cdc_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_cdc'"
		},
		"ls_AzureSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adf-advance-server.database.windows.net"
		},
		"ls_AzureSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adf-advance"
		},
		"ls_AzureSql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sbb"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saadlsazurelearning.dfs.core.windows.net/"
		},
		"ls_akv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://AkvAzureSql.vault.azure.net/"
		},
		"ls_cdc_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saadlsazurelearningtest.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-advance-testing_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_accountKey": {
						"value": "[parameters('ls_adls_accountKey')]"
					},
					"ls_cdc_accountKey": {
						"value": "[parameters('ls_cdc_accountKey')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_akv_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_akv_properties_typeProperties_baseUrl')]"
					},
					"ls_cdc_properties_typeProperties_url": {
						"value": "[parameters('ls_cdc_properties_typeProperties_url')]"
					},
					"ls_AzureSql_properties_typeProperties_server": {
						"value": "[parameters('ls_AzureSql_properties_typeProperties_server')]"
					},
					"ls_AzureSql_properties_typeProperties_database": {
						"value": "[parameters('ls_AzureSql_properties_typeProperties_database')]"
					},
					"ls_AzureSql_properties_typeProperties_userName": {
						"value": "[parameters('ls_AzureSql_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}